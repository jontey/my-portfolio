{
  "name": "my-portfolio",
  "version": "1.0.0",
  "description": "Portfolio using Webpack + React.js",
  "main": "js/scripts.js",
  "scripts": {
    "build": "webpack --config webpack/webpack.prod.config.js --progress",
    "watch": "webpack --config webpack/webpack.prod.config.js --watch",
    "start": "node webpack/server.js",
    "precommit": "lint-staged",
    "test": "npm run build"
  },
  "lint-staged": {
    "*.{js,json,css,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jontey/my-portfolio.git"
  },
  "homepage": "https://github.com/jontey/my-portfolio#readme",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "sass-embedded": "^1.93.2",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "babel-loader": "^9.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "css-loader": "^7.1.2",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "mini-css-extract-plugin": "^2.9.2",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-ga": "^3.3.1",
    "sass": "^1.83.2",
    "sass-loader": "^16.0.5",
    "tailwind-merge": "^3.3.1",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  }
}
