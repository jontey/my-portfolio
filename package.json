{
  "name": "my-portfolio",
  "version": "1.0.0",
  "description": "Portfolio using Webpack + React.js",
  "main": "js/scripts.js",
  "scripts": {
    "build": "webpack --config webpack/webpack.prod.config.js --progress",
    "watch": "webpack --config webpack/webpack.prod.config.js --watch",
    "start": "node webpack/server.js",
    "precommit": "lint-staged",
    "test": "npm run build"
  },
  "lint-staged": {
    "*.{js,json,css,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jontey/my-portfolio.git"
  },
  "homepage": "https://github.com/jontey/my-portfolio#readme",
  "license": "MIT",
  "devDependencies": {
    "react-hot-loader": "^4.0.0",
    "sass-embedded": "^1.93.2",
    "style-loader": "^3.3.0",
    "webpack-dev-server": "^4.11.0"
  },
  "dependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/preset-react": "^7.18.0",
    "@fortawesome/fontawesome": "^1.1.4",
    "@fortawesome/fontawesome-free-brands": "^5.0.8",
    "@fortawesome/fontawesome-free-regular": "^5.0.8",
    "@fortawesome/fontawesome-free-solid": "^5.0.8",
    "@fortawesome/react-fontawesome": "0.0.20",
    "babel-loader": "^8.2.4",
    "css-loader": "^4.0.0",
    "file-loader": "^6.0.0",
    "greenkeeper-lockfile": "^1.14.0",
    "html-loader": "^1.0.0",
    "html-webpack-plugin": "^5.0.0",
    "husky": "^2.0.0",
    "lint-staged": "^10.0.3",
    "mini-css-extract-plugin": "^2.7.0",
    "mini.css": "^3.0.1",
    "prettier": "^2.0.0",
    "react": "^16.0.0",
    "react-dom": "^16.0.0",
    "react-ga": "^2.5.2",
    "sass": "^1.60.0",
    "sass-loader": "^13.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^4.0.0",
    "webpack-merge": "^5.8.0"
  }
}
